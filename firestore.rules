rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMember() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isAdmin() {
      return isMember()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function bootstrapIsOpen() {
      return !exists(/databases/$(database)/documents/config/bootstrap);
    }

    function isClaimingFirstAdmin(uid) {
      return isAuthenticated()
        && request.auth.uid == uid
        && bootstrapIsOpen()
        && existsAfter(/databases/$(database)/documents/config/bootstrap)
        && getAfter(/databases/$(database)/documents/config/bootstrap).data.uid == uid;
    }

    function validAccountData() {
      return request.resource.data.keys().hasOnly(['email', 'nom'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && (!('nom' in request.resource.data)
          || (request.resource.data.nom is string
            && request.resource.data.nom.size() <= 120));
    }

    // Initialisation atomique : le premier compte authentifié devient admin.
    // Le document bootstrap est définitif et ne peut jamais être remplacé.
    match /config/bootstrap {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && bootstrapIsOpen()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update, delete: if false;
    }

    // Un compte désactivé perd immédiatement son accès lorsque son document
    // members/{uid} est supprimé par un administrateur.
    match /members/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if (isAdmin() || isClaimingFirstAdmin(uid))
        && validAccountData();
      allow update: if isAdmin() && validAccountData();
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Seul un administrateur existant peut accorder ou retirer le rôle admin.
    match /admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if (isAdmin() || isClaimingFirstAdmin(uid))
        && validAccountData();
      allow update: if isAdmin() && validAccountData();
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Profils applicatifs : lecture des membres, écriture réservée aux admins.
    match /utilisateurs/{id} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    // Journal technique des opérations idempotentes de stock.
    // L'application ne crée que des marqueurs d'incrément de stock produit.
    match /_ops/{opId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['t', 'id', 'exp'])
        && request.resource.data.t == 'produits'
        && request.resource.data.id is string
        && request.resource.data.exp is timestamp;
      allow update, delete: if false;
    }

    // Données métier utilisées par l'application.
    // Les membres actifs peuvent lire, créer et modifier les données.
    // La suppression reste réservée aux administrateurs.
    match /{collection}/{document} {
      allow read, create, update: if isMember()
        && collection in [
          'produits', 'mouvements', 'ventes', 'commandes',
          'fournisseurs', 'clients', 'depenses', 'retours',
          'categories', 'journal'
        ];
      allow delete: if isAdmin()
        && collection in [
          'produits', 'mouvements', 'ventes', 'commandes',
          'fournisseurs', 'clients', 'depenses', 'retours',
          'categories', 'journal'
        ];
    }

    // Tout chemin ou collection non explicitement autorisé est refusé.
  }
}
